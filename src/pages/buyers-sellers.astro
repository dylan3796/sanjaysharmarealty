---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import { site } from '../config/site';
---

<Base
  title="Buyers and sellers"
  description={`${site.brokerName} represents home buyers and sellers in ${site.areas.join(', ')}. Request a free consultation.`}
>
  <div class="page-head">
    <div class="wrap">
      <p class="eyebrow">Buyers and sellers</p>
      <h1>Buying or selling a home?</h1>
      <p class="lead">
        Sanjay represents you from the first conversation until the sale is complete. You deal with him, and only him.
      </p>
      <div class="btn-row">
        <a class="btn btn--big" href="#consultation">Request a free consultation</a>
      </div>
    </div>
  </div>

  <section class="section">
    <div class="wrap grid grid--2">
      <div class="card card--service" id="sellers">
        <p class="eyebrow">For sellers</p>
        <h2>Selling your home</h2>
        <ul class="ticks">
          <li>He tells you what your home is worth.</li>
          <li>He advertises it and shows it to buyers.</li>
          <li>He handles the offers and the paperwork until it is sold.</li>
        </ul>
        <a class="btn" href="/valuation/">Find out what my home is worth</a>
      </div>

      <div class="card card--service" id="buyers">
        <p class="eyebrow">For buyers</p>
        <h2>Buying a home</h2>
        <ul class="ticks">
          <li>He helps you get ready to buy, including a loan pre-approval with a lender you choose.</li>
          <li>He finds homes that fit and takes you to see them.</li>
          <li>He makes your offer and handles the paperwork until you have the keys.</li>
        </ul>
        <a class="btn" href="/properties/">See homes for sale</a>
      </div>
    </div>
  </section>

  <section class="section section--deep" id="consultation">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Free consultation</p>
        <h2>Talk it through with Sanjay first</h2>
        <p class="lead">A consultation is free, and you are not signing up for anything.</p>
        <ul class="ticks">
          <li>Leave your name and phone number.</li>
          <li>Sanjay calls you back.</li>
          <li>You ask your questions and decide what to do next.</li>
        </ul>
      </div>
      <LeadForm kind="buyer-seller" request="Free consultation: buying or selling a home" submitLabel="Request a free consultation" />
    </div>
  </section>
</Base>
