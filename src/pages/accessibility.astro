---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
---

<Base title="Accessibility">
  <div class="page-head">
    <div class="wrap">
      <p class="eyebrow">Accessibility</p>
      <h1>This site should work for everyone</h1>
    </div>
  </div>

  <section class="section">
    <div class="wrap">
      <p>
        {site.brokerName} aims for this website to meet the Web Content Accessibility Guidelines (WCAG) 2.1, level AA. It
        is built to work with a keyboard and with screen readers, and to remain readable when text is enlarged.
      </p>
      <p>
        If any part of the site is hard for you to use, or you need information in another format, call
        <a href={site.phone.href}>{site.phone.display}</a> or email
        <a href={`mailto:${site.email}`}>{site.email}</a>. Sanjay will help you directly and the problem will be fixed.
      </p>
    </div>
  </section>
</Base>
