---
import Base from '../layouts/Base.astro';
import ContactCta from '../components/ContactCta.astro';
import { site } from '../config/site';
import { testimonials } from '../lib/content';

const reviewLinks = [
  ['Zillow', site.social.zillow],
  ['Google', site.social.google],
].filter(([, url]) => url);
---

<Base title="Testimonials" description={`What clients say about working with ${site.brokerName}.`}>
  <div class="page-head">
    <div class="wrap">
      <p class="eyebrow">Testimonials</p>
      <h1>In clients' words</h1>
      <p class="lead">Comments from people Sanjay has represented, shared with their permission.</p>
    </div>
  </div>

  <section class="section">
    <div class="wrap">
      {
        testimonials.length > 0 ? (
          <div class="grid grid--2">
            {testimonials.map((t) => (
              <figure class="card t">
                <blockquote>
                  <p>{t.quote}</p>
                </blockquote>
                <figcaption>
                  <strong>{t.name}</strong>
                  <span>{t.context}</span>
                  {t.sample && <span class="tag tag--sample">Sample</span>}
                </figcaption>
              </figure>
            ))}
          </div>
        ) : (
          <p>Client comments will be added here soon.</p>
        )
      }
      {
        reviewLinks.length > 0 && (
          <p class="more">
            Read more reviews on{' '}
            {reviewLinks.map(([name, url], i) => (
              <>
                {i > 0 && ' and '}
                <a href={url} rel="noopener">
                  {name}
                </a>
              </>
            ))}
            .
          </p>
        )
      }
    </div>
  </section>

  <ContactCta />
</Base>

<style>
  .t {
    margin: 0;
    border-top: 3px solid var(--brass-bright);
  }

  .t blockquote {
    margin: 0;
    font: 400 1.2rem/1.55 var(--serif);
  }

  .t figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: center;
    margin-top: 0.5rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .t figcaption strong {
    color: var(--ink);
  }

  .more {
    margin-top: 2rem;
  }
</style>
