---
import Base from '../layouts/Base.astro';
import Headshot from '../components/Headshot.astro';
import ListingCard from '../components/ListingCard.astro';
import TrackRecord from '../components/TrackRecord.astro';
import IdxSlot from '../components/IdxSlot.astro';
import LeadForm from '../components/LeadForm.astro';
import { site, licenseLine } from '../config/site';
import { listings, sales, testimonials } from '../lib/content';

const quote = testimonials[0];
---

<Base>
  <section class="hero">
    <div class="wrap split split--wide-left">
      <div class="hero-text">
        <p class="eyebrow">Independent California real estate broker</p>
        <h1>
          Experience.<br />Integrity.<br /><span class="accent">Results.</span>
        </h1>
        <p class="lead">
          {site.brokerName} has spent {site.yearsExperience} years helping people buy and sell homes, land and investment
          property. Based in {site.homeBase}, he serves clients throughout California.
        </p>
        <div class="btn-row">
          <a class="btn btn--big" href="#contact">Contact Sanjay</a>
          {
            site.idx.searchUrl && (
              <a class="btn btn--big btn--ghost" href={site.idx.searchUrl} target="_blank" rel="noopener">
                Search homes<span class="visually-hidden"> on {site.idx.mlsName} (opens in a new tab)</span>
              </a>
            )
          }
        </div>
      </div>
      <Headshot />
    </div>
  </section>

  <section class="section section--deep" id="contact">
    <div class="wrap contact-grid">
      <div class="intro">
        <p class="eyebrow">Contact Sanjay</p>
        <h2>Tell Sanjay what you need</h2>
        <p class="lead">Tap what you need, leave your name and a phone number or email, and press send.</p>
      </div>
      <div class="form">
        <LeadForm kind="contact" request="General message" />
      </div>
      <div class="extra">
        <ul class="ticks">
          <li>Sanjay reads every message himself.</li>
          <li>He gets in touch to talk it through.</li>
          <li>A home valuation is free, and you do not have to sell.</li>
        </ul>
        <p class="note">{licenseLine}. {site.independentStatement}</p>
      </div>
    </div>
  </section>

  <section class="section" id="listings">
    <div class="wrap">
      <IdxSlot first />
      {
        listings.length > 0 && (
          <>
            <p class="eyebrow">Listings</p>
            <h2>{site.brokerName}'s properties for sale</h2>
            <div class="grid grid--3">
              {listings.map((listing) => (
                <ListingCard listing={listing} />
              ))}
            </div>
          </>
        )
      }
    </div>
  </section>

  {
    sales.length > 0 && (
      <section class="section section--navy">
        <div class="wrap">
          <p class="eyebrow">Track record</p>
          <h2>{site.yearsExperience} years of California transactions</h2>
          <TrackRecord />
        </div>
      </section>
    )
  }

  {
    quote && (
      <section class="section section--deep">
        <div class="wrap">
          <figure class="quote">
            <blockquote>
              <p>{quote.quote}</p>
            </blockquote>
            <figcaption>
              <strong>{quote.name}</strong>
              <span>{quote.context}</span>
              {quote.sample && <span class="tag tag--sample">Sample</span>}
            </figcaption>
          </figure>
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 5rem) clamp(3.5rem, 8vw, 5.5rem);
    overflow: hidden;
  }

  .hero .split {
    align-items: center;
  }

  .hero h1 {
    margin-bottom: 0.45em;
  }

  .accent {
    color: var(--brass);
    font-style: italic;
  }

  .hero .lead {
    max-width: 34rem;
  }

  /* The sticky header covers the top of the page when a link jumps to a section. */
  :global(#contact),
  :global(#listings) {
    scroll-margin-top: 5.5rem;
  }

  .contact-grid {
    display: grid;
    gap: 1.5rem;
  }

  .contact-grid .intro .lead {
    margin-bottom: 0;
  }

  .contact-grid .note {
    margin-top: 1.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  /* Side by side on a wide screen: the words on the left, the form on the right. */
  @media (min-width: 56rem) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        'intro form'
        'extra form';
      grid-template-rows: auto 1fr;
      gap: 1.5rem clamp(2rem, 5vw, 4rem);
    }
    .contact-grid .intro {
      grid-area: intro;
    }
    .contact-grid .form {
      grid-area: form;
    }
    .contact-grid .extra {
      grid-area: extra;
    }
  }









  .quote {
    margin: 0 auto;
    max-width: 46rem;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    background: var(--card);
    border: 1px solid var(--line);
    border-left: 3px solid var(--brass-bright);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .quote blockquote {
    margin: 0;
    font: 400 1.3rem/1.5 var(--serif);
  }

  .quote figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: center;
    margin: 1rem 0 0;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .quote figcaption strong {
    color: var(--ink);
  }

</style>
