---
import Base from '../layouts/Base.astro';
import Headshot from '../components/Headshot.astro';
import ListingCard from '../components/ListingCard.astro';
import TrackRecord from '../components/TrackRecord.astro';
import ContactCta from '../components/ContactCta.astro';
import { site } from '../config/site';
import { listings, sales, testimonials } from '../lib/content';

const featured = listings.filter((l) => l.status !== 'sold').slice(0, 3);
const quote = testimonials[0];
const areaList = `${site.areas.slice(0, -1).join(', ')} and ${site.areas.at(-1)}`;
---

<Base>
  <section class="hero">
    <div class="wrap split split--wide-left">
      <div class="hero-text">
        <p class="eyebrow">Independent California real estate broker</p>
        <h1>
          Experience.<br />Integrity.<br /><span class="accent">Results.</span>
        </h1>
        <p class="lead">
          {site.brokerName} has spent {site.yearsExperience} years helping people buy and sell homes, land and investment
          property in {areaList}.
        </p>
        <div class="btn-row">
          <a class="btn" href="/valuation/">Request a home valuation</a>
          <a class="btn btn--ghost" href="/properties/">View properties</a>
        </div>
      </div>
      <Headshot />
    </div>
  </section>

  <section class="section section--deep">
    <div class="wrap">
      <p class="eyebrow">How Sanjay can help</p>
      <h2>One broker, from first conversation to closing</h2>
      <div class="grid grid--3 services">
        <a class="card service" href="/buyers-sellers/#sellers">
          <h3>Selling</h3>
          <p>Pricing based on current local sales, a clear marketing plan, and negotiation by the broker himself.</p>
          <span class="more">For sellers</span>
        </a>
        <a class="card service" href="/buyers-sellers/#buyers">
          <h3>Buying</h3>
          <p>Straight advice on value, condition and offer terms, so you know what you are buying and why.</p>
          <span class="more">For buyers</span>
        </a>
        <a class="card service" href="/land-investment/">
          <h3>Land and investment</h3>
          <p>Lots, acreage and income property, with the extra checks these purchases need.</p>
          <span class="more">Land &amp; investment</span>
        </a>
      </div>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="heading-row">
            <div>
              <p class="eyebrow">Current listings</p>
              <h2>Properties for sale</h2>
            </div>
            <a class="btn btn--ghost" href="/properties/">
              See all properties
            </a>
          </div>
          <div class="grid grid--3">
            {featured.map((listing) => (
              <ListingCard listing={listing} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    sales.length > 0 && (
  <section class="section section--navy">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Track record</p>
        <h2>{site.yearsExperience} years of California transactions</h2>
        <p>
          Markets change. The work of pricing a property correctly, presenting it well and negotiating carefully does
          not.
        </p>
        <div class="btn-row">
          <a class="btn btn--ghost" href="/about/#track-record">See past sales</a>
        </div>
      </div>
      <TrackRecord />
    </div>
  </section>
    )
  }

  <section class:list={['section', sales.length === 0 && 'section--deep']}>
    <div class="wrap split">
      <div>
        <p class="eyebrow">Property valuation</p>
        <h2>What is your property worth today?</h2>
        <p class="lead">
          Send the address and Sanjay will prepare a personal opinion of value from recent comparable sales. It is free,
          and there is no obligation.
        </p>
        <div class="btn-row">
          <a class="btn" href="/valuation/">Request a valuation</a>
        </div>
      </div>
      {
        quote && (
          <figure class="quote">
            <blockquote>
              <p>{quote.quote}</p>
            </blockquote>
            <figcaption>
              <strong>{quote.name}</strong>
              <span>{quote.context}</span>
              {quote.sample && <span class="tag tag--sample">Sample</span>}
            </figcaption>
            <a href="/testimonials/">More from clients</a>
          </figure>
        )
      }
    </div>
  </section>

  <ContactCta />
</Base>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 5rem) clamp(3.5rem, 8vw, 5.5rem);
    overflow: hidden;
  }

  .hero .split {
    align-items: center;
  }

  .hero h1 {
    margin-bottom: 0.45em;
  }

  .accent {
    color: var(--brass);
    font-style: italic;
  }

  .hero .lead {
    max-width: 34rem;
  }

  .services {
    margin-top: 2rem;
  }

  .service {
    display: grid;
    gap: 0.25rem;
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }

  .service:hover {
    border-color: var(--brass);
    transform: translateY(-2px);
  }

  .service p {
    color: var(--ink-soft);
  }

  .more {
    margin-top: 0.75rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--brass);
  }

  .more::after {
    content: ' \2192';
  }

  .heading-row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .heading-row h2 {
    margin: 0;
  }

  .quote {
    margin: 0;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    background: var(--card);
    border: 1px solid var(--line);
    border-left: 3px solid var(--brass-bright);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .quote blockquote {
    margin: 0;
    font: 400 1.3rem/1.5 var(--serif);
  }

  .quote figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: center;
    margin: 1rem 0;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .quote figcaption strong {
    color: var(--ink);
  }

  .quote a {
    font-weight: 600;
    font-size: 0.95rem;
  }
</style>
