---
import Base from '../layouts/Base.astro';
import Headshot from '../components/Headshot.astro';
import ListingCard from '../components/ListingCard.astro';
import TrackRecord from '../components/TrackRecord.astro';
import ContactCta from '../components/ContactCta.astro';
import { site, services } from '../config/site';
import { listings, sales, testimonials } from '../lib/content';

const featured = listings.filter((l) => l.status !== 'sold').slice(0, 3);
const quote = testimonials[0];
---

<Base>
  <section class="hero">
    <div class="wrap split split--wide-left">
      <div class="hero-text">
        <p class="eyebrow">Independent California real estate broker</p>
        <h1>
          Experience.<br />Integrity.<br /><span class="accent">Results.</span>
        </h1>
        <p class="lead">
          {site.brokerName} has spent {site.yearsExperience} years helping people buy and sell homes, land and investment
          property. Based in {site.homeBase}, he serves clients throughout California.
        </p>
        <div class="btn-row">
          <a class="btn btn--big" href="/contact/">Contact Sanjay</a>
          <a class="btn btn--big btn--ghost" href="/properties/">See listings</a>
        </div>
      </div>
      <Headshot />
    </div>
  </section>

  <section class="section section--deep">
    <div class="wrap">
      <p class="eyebrow">How Sanjay can help</p>
      <h2>Tell him what you need. He takes it from there.</h2>
      <div class="services">
        {
          services.map((service) => (
            <a class="card service" href={`/contact/?topic=${service.id}`}>
              <h3>{service.title}</h3>
              <p>{service.text}</p>
              <span class="more">Ask Sanjay</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="heading-row">
            <div>
              <p class="eyebrow">Listings</p>
              <h2>Properties for sale</h2>
            </div>
            <a class="btn btn--ghost" href="/properties/">
              See all listings
            </a>
          </div>
          <div class="grid grid--3">
            {featured.map((listing) => (
              <ListingCard listing={listing} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    sales.length > 0 && (
      <section class="section section--navy">
        <div class="wrap">
          <p class="eyebrow">Track record</p>
          <h2>{site.yearsExperience} years of California transactions</h2>
          <TrackRecord />
        </div>
      </section>
    )
  }

  {
    quote && (
      <section class="section">
        <div class="wrap">
          <figure class="quote">
            <blockquote>
              <p>{quote.quote}</p>
            </blockquote>
            <figcaption>
              <strong>{quote.name}</strong>
              <span>{quote.context}</span>
              {quote.sample && <span class="tag tag--sample">Sample</span>}
            </figcaption>
          </figure>
        </div>
      </section>
    )
  }

  <ContactCta />
</Base>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 5rem) clamp(3.5rem, 8vw, 5.5rem);
    overflow: hidden;
  }

  .hero .split {
    align-items: center;
  }

  .hero h1 {
    margin-bottom: 0.45em;
  }

  .accent {
    color: var(--brass);
    font-style: italic;
  }

  .hero .lead {
    max-width: 34rem;
  }

  .services {
    margin-top: 2rem;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14.5rem), 1fr));
  }

  .service {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.25rem;
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }

  .service:hover {
    border-color: var(--brass);
    transform: translateY(-2px);
  }

  .service p {
    color: var(--ink-soft);
  }

  .more {
    margin-top: 0.75rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--brass);
  }

  .more::after {
    content: ' \2192';
  }

  .heading-row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .heading-row h2 {
    margin: 0;
  }

  .quote {
    margin: 0 auto;
    max-width: 46rem;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    background: var(--card);
    border: 1px solid var(--line);
    border-left: 3px solid var(--brass-bright);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .quote blockquote {
    margin: 0;
    font: 400 1.3rem/1.5 var(--serif);
  }

  .quote figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: center;
    margin: 1rem 0 0;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .quote figcaption strong {
    color: var(--ink);
  }

</style>
