---
import Base from '../layouts/Base.astro';
import ListingCard from '../components/ListingCard.astro';
import LeadForm from '../components/LeadForm.astro';
import { site } from '../config/site';
import { listings } from '../lib/content';

const matches = listings.filter((l) => l.category === 'land' || l.category === 'investment');
---

<Base
  title="Land and investment properties"
  description={`${site.brokerName} helps clients buy and sell land, lots and rental property in ${site.areas.join(', ')}.`}
>
  <div class="page-head">
    <div class="wrap">
      <p class="eyebrow">Land and investment properties</p>
      <h1>Land and rental property</h1>
      <p class="lead">
        Buying land or a rental is not the same as buying a home. Sanjay knows what to check before you spend your
        money.
      </p>
      <div class="btn-row">
        <a class="btn btn--big" href="#consultation">Request a free consultation</a>
      </div>
    </div>
  </div>

  <section class="section">
    <div class="wrap grid grid--2">
      <div class="card card--service">
        <p class="eyebrow">Land</p>
        <h2>Lots and acreage</h2>
        <ul class="ticks">
          <li>He helps you find the right piece of land.</li>
          <li>He helps you check what can be built, and whether it has road access, water and power.</li>
          <li>He handles the offer and the paperwork.</li>
        </ul>
      </div>
      <div class="card card--service">
        <p class="eyebrow">Investment</p>
        <h2>Rental and income property</h2>
        <ul class="ticks">
          <li>He helps you find property that brings in rent.</li>
          <li>He helps you check the real rents and costs before you buy.</li>
          <li>He handles the offer and the paperwork.</li>
        </ul>
      </div>
    </div>
    <div class="wrap">
      <p class="selling">
        Selling land or a rental property? Sanjay does that too.
        <a href="/valuation/">Find out what it is worth</a>.
      </p>
    </div>
  </section>

  {
    matches.length > 0 && (
      <section class="section section--deep">
        <div class="wrap">
          <p class="eyebrow">Available now</p>
          <h2>Land and investment listings</h2>
          <div class="grid grid--3">
            {matches.map((listing) => (
              <ListingCard listing={listing} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section" id="consultation">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Free consultation</p>
        <h2>Tell Sanjay what you are looking for</h2>
        <p class="lead">Leave your name and a phone number or email, and he will get in touch. It is free.</p>
        <p class="note">
          Nothing on this site is a promise of profit, or tax or legal advice. Buyers should confirm zoning, permitted
          use, income and costs for themselves.
        </p>
      </div>
      <LeadForm kind="buyer-seller" request="Free consultation: land or investment property" submitLabel="Request a free consultation" />
    </div>
  </section>
</Base>

<style>
  .selling {
    margin: 1.75rem 0 0;
    font-size: 1.1rem;
  }

  .selling a {
    font-weight: 600;
  }
</style>
