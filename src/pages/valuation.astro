---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import { site } from '../config/site';
---

<Base
  title="Free property valuation"
  description={`Request a complimentary property valuation and comparative market analysis (CMA) from ${site.brokerName}.`}
>
  <div class="page-head">
    <div class="wrap">
      <p class="eyebrow">Property valuation</p>
      <h1>Find out what your property is worth</h1>
      <p class="lead">
        A complimentary valuation from a broker with {site.yearsExperience} years of experience. It is free, and you do
        not have to sell.
      </p>
    </div>
  </div>

  <section class="section">
    <div class="wrap split">
      <LeadForm kind="valuation" request="Free property valuation (CMA)" submitLabel="Get my free valuation" />
      <div>
        <h2>How it works</h2>
        <ol class="steps">
          <li>
            <div>
              <h3>Fill in the form</h3>
              <p>Your name and a phone number or email. The street or neighborhood helps, but is optional.</p>
            </div>
          </li>
          <li>
            <div>
              <h3>Sanjay gets in touch</h3>
              <p>He asks a few simple questions about the property.</p>
            </div>
          </li>
          <li>
            <div>
              <h3>You get your report</h3>
              <p>
                It is called a comparative market analysis, or CMA. It compares your property with similar ones sold
                nearby and shows what it could sell for today.
              </p>
            </div>
          </li>
        </ol>
        <p class="note disclaimer">Refinancing? A lender will still need its own appraisal.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .steps h3 {
    font-size: 1.25rem;
  }

  .steps p {
    font-size: 1.05rem;
  }

  .disclaimer {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
</style>
