---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import { site, licenseLine } from '../config/site';
---

<Base title="Contact" description={`Call, email or message ${site.brokerName}, independent California real estate broker.`}>
  <div class="page-head">
    <div class="wrap">
      <p class="eyebrow">Contact</p>
      <h1>Get in touch with Sanjay</h1>
      <p class="lead">Calls and messages go straight to him.</p>
    </div>
  </div>

  <section class="section">
    <div class="wrap split">
      <div>
        <dl class="ways">
          <div>
            <dt>Phone</dt>
            <dd><a href={site.phone.href}>{site.phone.display}</a></dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
          </div>
          <div>
            <dt>Areas served</dt>
            <dd>{site.areas.join(', ')}, California</dd>
          </div>
        </dl>
        {
          site.bookingUrl && (
            <div class="btn-row">
              <a class="btn" href={site.bookingUrl} rel="noopener">
                Book an appointment
              </a>
            </div>
          )
        }
        <p class="note license">
          {licenseLine}<br />
          {site.independentStatement}
        </p>
      </div>
      <LeadForm kind="contact" />
    </div>
  </section>
</Base>

<style>
  .ways {
    margin: 0;
    display: grid;
    gap: 1.5rem;
  }

  dt {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brass);
  }

  dd {
    margin: 0.2rem 0 0;
    font: 500 clamp(1.3rem, 3vw, 1.7rem) / 1.3 var(--serif);
    overflow-wrap: anywhere;
  }

  dd a {
    text-decoration: none;
  }

  dd a:hover {
    text-decoration: underline;
  }

  .license {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
</style>
