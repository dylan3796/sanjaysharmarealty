---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import { site, licenseLine, services } from '../config/site';
---

<Base title="Contact" description={`Contact ${site.brokerName}, independent California real estate broker.`}>
  <div class="page-head">
    <div class="wrap">
      <p class="eyebrow">Contact</p>
      <h1>Contact Sanjay</h1>
      <p class="lead">Leave your name and a phone number or email. Sanjay will get in touch himself.</p>
    </div>
  </div>

  <section class="section">
    <div class="wrap split">
      <div>
        <dl class="ways">
          <div>
            <dt>Sanjay can help with</dt>
            <dd>
              <ul class="ticks">
                {services.map((s) => <li>{s.title}</li>)}
              </ul>
            </dd>
          </div>
          <div>
            <dt>What happens next</dt>
            <dd>Sanjay reads every message himself and gets back to you. Your details are not shared with anyone.</dd>
          </div>
          <div>
            <dt>Where Sanjay works</dt>
            <dd>{site.serviceArea}</dd>
          </div>
        </dl>
        {
          site.bookingUrl && (
            <div class="btn-row">
              <a class="btn" href={site.bookingUrl} rel="noopener">
                Book an appointment
              </a>
            </div>
          )
        }
        <p class="note license">
          {licenseLine}<br />
          {site.independentStatement}
        </p>
      </div>
      <LeadForm kind="contact" request="General message" />
    </div>
  </section>
</Base>

<style>
  /* On a phone the form comes first, so nobody scrolls to find it. */
  @media (max-width: 55.99rem) {
    .split > :global(form) {
      order: -1;
    }
  }

  .ways {
    margin: 0;
    display: grid;
    gap: 1.5rem;
  }

  dt {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brass);
  }

  dd {
    margin: 0.2rem 0 0;
    font: 500 clamp(1.3rem, 3vw, 1.7rem) / 1.3 var(--serif);
    overflow-wrap: anywhere;
  }

  dd .ticks {
    margin: 0.5rem 0 0;
    font: 400 1.1rem/1.5 var(--sans);
  }

  dd a {
    text-decoration: none;
  }

  dd a:hover {
    text-decoration: underline;
  }

  .license {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
</style>
