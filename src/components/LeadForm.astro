---
// One short form for every inquiry. Visitors leave a name and number; Sanjay calls back.
// Every submission says in plain words what the visitor asked for (`request`), so he
// knows the reason before he picks up the phone.
// Submissions POST as JSON to site.formEndpoint; while that is empty the form
// opens the visitor's email app with the message filled in.
import { site, licenseLine } from '../config/site';

interface Props {
  kind: 'contact' | 'buyer-seller' | 'valuation' | 'listing';
  /** What the visitor is asking for, in plain words. Heads the message Sanjay receives. */
  request: string;
  /** Extra context for the broker, e.g. the listing address. */
  subject?: string;
  submitLabel?: string;
}

const { kind, request, subject = '', submitLabel = 'Send to Sanjay' } = Astro.props;
const uid = `f-${kind}`;
const topics = ['Buying a home', 'Selling a home', 'Land or investment property', 'A free home valuation', 'Something else'];
---

<form
  class="lead-form"
  data-lead-form
  data-kind={kind}
  data-endpoint={site.formEndpoint}
  data-access-key={site.formAccessKey}
  data-email={site.email}
  novalidate
>
  <input type="hidden" name="request" value={request} />
  {subject && <input type="hidden" name="regarding" value={subject} />}
  <p class="hp" aria-hidden="true">
    <label>Leave this field empty <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="field">
    <label for={`${uid}-name`}>Your name</label>
    <input id={`${uid}-name`} name="name" type="text" autocomplete="name" required />
  </div>

  <div class="row">
    <div class="field">
      <label for={`${uid}-phone`}>Phone number</label>
      <input id={`${uid}-phone`} name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
    </div>
    <div class="field">
      <label for={`${uid}-email`}>Email <span class="opt">(optional)</span></label>
      <input id={`${uid}-email`} name="email" type="email" autocomplete="email" />
    </div>
  </div>

  {
    kind === 'contact' && (
      <div class="field">
        <label for={`${uid}-topic`}>What can Sanjay help you with?</label>
        <select id={`${uid}-topic`} name="topic">
          <option value="">Please choose</option>
          {topics.map((t) => (
            <option>{t}</option>
          ))}
        </select>
      </div>
    )
  }

  {
    kind === 'buyer-seller' && (
      <fieldset class="field choice">
        <legend>I am looking to</legend>
        <label>
          <input type="radio" name="interest" value="Buy" checked /> Buy
        </label>
        <label>
          <input type="radio" name="interest" value="Sell" /> Sell
        </label>
        <label>
          <input type="radio" name="interest" value="Buy and sell" /> Both
        </label>
      </fieldset>
    )
  }

  {
    kind === 'valuation' && (
      <div class="field">
        <label for={`${uid}-address`}>Property address</label>
        <input id={`${uid}-address`} name="propertyAddress" type="text" autocomplete="street-address" required />
      </div>
    )
  }

  <div class="field">
    <label for={`${uid}-msg`}>
      {kind === 'valuation' ? 'Anything Sanjay should know' : 'Message'}
      <span class="opt"> (optional)</span>
    </label>
    <textarea id={`${uid}-msg`} name="message" rows="3"></textarea>
  </div>

  <button class="btn" type="submit">{submitLabel}</button>

  <p class="status" role="status" aria-live="polite"></p>

  <p class="note fine">
    Sanjay will call or email you back using these details. See the{' '}
    <a href="/privacy/">privacy policy</a>. {licenseLine}.
  </p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-lead-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.textContent = '';
      status.className = 'status';

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      if (data.company) return; // honeypot: bots fill it, people never see it

      // What Sanjay sees, in the order he needs it: the request first, then who and how to reach them.
      const request = data.topic ? `${data.request}: ${data.topic}` : data.request;
      const fields: [string, string | undefined][] = [
        ['Request', request],
        ['Wants to', data.interest],
        ['Property', data.propertyAddress ?? data.regarding],
        ['Name', data.name],
        ['Phone', data.phone],
        ['Email', data.email],
        ['Message', data.message],
      ];
      const filled = fields.filter(([, value]) => value) as [string, string][];
      const subject = `${request} - ${data.name}`;
      const endpoint = form.dataset.endpoint;

      if (!endpoint) {
        // No form service configured yet: hand the message to the visitor's email app.
        const body = filled.map(([name, value]) => `${name}: ${value}`).join('\n');
        window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        status.textContent = 'Your email app should now open with the message ready to send.';
        return;
      }

      button.disabled = true;
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            ...(form.dataset.accessKey ? { access_key: form.dataset.accessKey } : {}),
            subject,
            ...Object.fromEntries(filled),
            Page: window.location.pathname,
          }),
        });
        if (!response.ok) throw new Error(String(response.status));
        form.reset();
        status.textContent = 'Thank you. Sanjay has your details and will call you back.';
        status.classList.add('is-ok');
      } catch {
        status.textContent = `Sorry, that did not send. Please email ${form.dataset.email} instead.`;
        status.classList.add('is-error');
      } finally {
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .lead-form {
    display: grid;
    gap: 1.1rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-top: 3px solid var(--brass-bright);
    border-radius: var(--radius);
    padding: clamp(1.25rem, 3.5vw, 2rem);
    color: var(--ink);
  }

  .hp {
    position: absolute;
    left: -999rem;
  }

  .row {
    display: grid;
    gap: 1.1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
  }

  .field {
    display: grid;
    gap: 0.35rem;
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  label,
  legend {
    font-size: 0.95rem;
    font-weight: 600;
    padding: 0;
  }

  .opt {
    font-weight: 400;
    color: var(--ink-soft);
  }

  input[type='text'],
  input[type='tel'],
  input[type='email'],
  select,
  textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.65rem 0.8rem;
    border: 1.5px solid #b9b09c;
    border-radius: var(--radius);
    background: #fff;
    color: var(--ink);
    font: inherit;
  }

  textarea {
    resize: vertical;
  }

  .choice {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .choice legend {
    width: 100%;
    margin-bottom: 0.35rem;
  }

  .choice label {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
    font-weight: 400;
  }

  input[type='radio'] {
    width: 1.15rem;
    height: 1.15rem;
    margin: 0.2rem 0 0;
    accent-color: var(--navy);
    flex: none;
  }

  .btn {
    justify-self: start;
  }

  .status {
    margin: 0;
    font-weight: 600;
  }

  .status:empty {
    display: none;
  }

  .status.is-ok {
    color: var(--good);
  }

  .status.is-error {
    color: #9b2c1f;
  }

  .fine {
    margin: 0;
  }
</style>
