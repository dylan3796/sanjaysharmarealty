---
// One short form for every inquiry. It asks only for what that inquiry needs: a name and
// one way to reach the visitor are required, everything else is optional. Sanjay calls back.
// Every submission says in plain words what the visitor asked for (`request`), so he
// knows the reason before he picks up the phone.
// Submissions POST as JSON to site.formEndpoint; while that is empty the form
// opens the visitor's email app with the message filled in.
import { site, licenseLine, services } from '../config/site';

interface Props {
  /** `contact` asks what it is about (one of the services); `listing` is about one property. */
  kind: 'contact' | 'listing';
  /** What the visitor is asking for, in plain words. Heads the message Sanjay receives. */
  request: string;
  /** Extra context for the broker, e.g. the listing address. */
  subject?: string;
  submitLabel?: string;
}

const { kind, request, subject = '', submitLabel = 'Send to Sanjay' } = Astro.props;
const uid = `f-${kind}`;
---

<form
  class="lead-form"
  data-lead-form
  data-kind={kind}
  data-endpoint={site.formEndpoint}
  data-access-key={site.formAccessKey}
  data-email={site.email}
  novalidate
>
  <input type="hidden" name="request" value={request} />
  {subject && <input type="hidden" name="regarding" value={subject} />}
  <p class="hp" aria-hidden="true">
    <label>Leave this field empty <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="row">
    <div class="field">
      <label for={`${uid}-name`}>Your name <span class="opt">(first name is fine)</span></label>
      <input id={`${uid}-name`} name="name" type="text" autocomplete="given-name" required />
    </div>
    <div class="field">
      <label for={`${uid}-reach`}>Phone or email</label>
      <input
        id={`${uid}-reach`}
        name="reach"
        type="text"
        autocomplete="tel"
        required
        data-reach
        aria-describedby={`${uid}-reach-hint`}
      />
      <span class="hint" id={`${uid}-reach-hint`}>Whichever you prefer Sanjay to use.</span>
    </div>
  </div>

  {
    kind === 'contact' && (
      <div class="field">
        <label for={`${uid}-topic`}>
          What can Sanjay help with? <span class="opt">(optional)</span>
        </label>
        <select id={`${uid}-topic`} name="topic" data-topic>
          <option value="">Please choose</option>
          {services.map((s) => (
            <option value={s.title} data-id={s.id} data-asks-property={s.asksProperty ? '' : undefined}>
              {s.title}
            </option>
          ))}
          <option value="Something else" data-id="other">
            Something else
          </option>
        </select>
      </div>
    )
  }

  {
    kind === 'contact' && (
      <div class="field" data-property-field hidden>
        <label for={`${uid}-address`}>
          Which property? <span class="opt">(optional)</span>
        </label>
        <input
          id={`${uid}-address`}
          name="propertyAddress"
          type="text"
          autocomplete="off"
          aria-describedby={`${uid}-address-hint`}
        />
        <span class="hint" id={`${uid}-address-hint`}>
          The street or neighborhood is enough. Sanjay will ask the rest when he gets in touch.
        </span>
      </div>
    )
  }

  <div class="field">
    <label for={`${uid}-msg`}>
      Message <span class="opt">(optional)</span>
    </label>
    <textarea id={`${uid}-msg`} name="message" rows="3"></textarea>
  </div>

  <p class="private">Only Sanjay sees this. It is never shared or sold.</p>

  <button class="btn" type="submit">{submitLabel}</button>

  <p class="status" role="status" aria-live="polite"></p>

  <p class="note fine">
    Sanjay will contact you using the details above. See the{' '}
    <a href="/privacy/">privacy policy</a>. {licenseLine}.
  </p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-lead-form]').forEach((form) => {
    const topic = form.querySelector<HTMLSelectElement>('[data-topic]');
    const propertyField = form.querySelector<HTMLElement>('[data-property-field]');
    const syncProperty = () => {
      if (!topic || !propertyField) return;
      const asks = topic.selectedOptions[0]?.hasAttribute('data-asks-property') ?? false;
      propertyField.hidden = !asks;
      if (!asks) propertyField.querySelector('input')!.value = '';
    };
    if (topic) {
      const wanted = new URLSearchParams(window.location.search).get('topic');
      const match = [...topic.options].find((o) => o.dataset.id === wanted);
      if (match) topic.value = match.value;
      topic.addEventListener('change', syncProperty);
      syncProperty();
    }

    form.querySelector<HTMLInputElement>('[data-reach]')?.addEventListener('input', (event) => {
      (event.target as HTMLInputElement).setCustomValidity('');
    });

    const status = form.querySelector<HTMLElement>('.status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.textContent = '';
      status.className = 'status';

      const reach = form.querySelector<HTMLInputElement>('[data-reach]')!;
      const value = reach.value.trim();
      const looksReachable = value.includes('@') || value.replace(/\D/g, '').length >= 7;
      reach.setCustomValidity(value && !looksReachable ? 'Please enter a phone number or an email address.' : '');

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      if (data.company) return; // honeypot: bots fill it, people never see it

      // What Sanjay sees, in the order he needs it: the request first, then who and how to reach them.
      const request = data.topic || data.request;
      const fields: [string, string | undefined][] = [
        ['Request', request],
        ['Property', data.propertyAddress || data.regarding],
        ['Name', data.name],
        ['Phone or email', data.reach],
        ['Message', data.message],
      ];
      const filled = fields.filter(([, value]) => value) as [string, string][];
      const subject = `${request} - ${data.name}`;
      const endpoint = form.dataset.endpoint;

      if (!endpoint) {
        // No form service configured yet: hand the message to the visitor's email app.
        const body = filled.map(([name, value]) => `${name}: ${value}`).join('\n');
        window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        status.textContent = 'Your email app should now open with the message ready to send.';
        return;
      }

      button.disabled = true;
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            ...(form.dataset.accessKey ? { access_key: form.dataset.accessKey } : {}),
            subject,
            ...Object.fromEntries(filled),
            Page: window.location.pathname,
          }),
        });
        if (!response.ok) throw new Error(String(response.status));
        form.reset();
        syncProperty();
        status.textContent = 'Thank you. Sanjay has your message and will be in touch.';
        status.classList.add('is-ok');
      } catch {
        status.textContent = `Sorry, that did not send. Please email ${form.dataset.email} instead.`;
        status.classList.add('is-error');
      } finally {
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .lead-form {
    display: grid;
    gap: 1.1rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-top: 3px solid var(--brass-bright);
    border-radius: var(--radius);
    padding: clamp(1.25rem, 3.5vw, 2rem);
    color: var(--ink);
  }

  .hp {
    position: absolute;
    left: -999rem;
  }

  .row {
    display: grid;
    gap: 1.1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    align-items: start;
  }

  .field[hidden] {
    display: none;
  }

  .field {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  label {
    font-size: 0.95rem;
    font-weight: 600;
    padding: 0;
  }

  .opt {
    font-weight: 400;
    color: var(--ink-soft);
  }

  .hint {
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  .private {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
  }

  input[type='text'],
  input[type='tel'],
  input[type='email'],
  select,
  textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.65rem 0.8rem;
    border: 1.5px solid #b9b09c;
    border-radius: var(--radius);
    background: #fff;
    color: var(--ink);
    font: inherit;
  }

  textarea {
    resize: vertical;
  }

  .btn {
    justify-self: start;
  }

  .status {
    margin: 0;
    font-weight: 600;
  }

  .status:empty {
    display: none;
  }

  .status.is-ok {
    color: var(--good);
  }

  .status.is-error {
    color: #9b2c1f;
  }

  .fine {
    margin: 0;
  }
</style>
