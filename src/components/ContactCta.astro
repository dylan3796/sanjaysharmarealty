---
import { site } from '../config/site';

interface Props {
  heading?: string;
  text?: string;
}
const {
  heading = 'Talk with Sanjay directly',
  text = 'No call center and no hand-offs. Your call or message goes to the broker who will handle your sale or purchase.',
} = Astro.props;
---

<section class="section section--navy">
  <div class="wrap">
    <p class="eyebrow">Get in touch</p>
    <h2>{heading}</h2>
    <p>{text}</p>
    <div class="btn-row">
      <a class="btn" href={site.phone.href}>Call {site.phone.display}</a>
      <a class="btn btn--ghost" href="/contact/">Send a message</a>
      {
        site.bookingUrl && (
          <a class="btn btn--ghost" href={site.bookingUrl} rel="noopener">
            Book a call
          </a>
        )
      }
    </div>
  </div>
</section>
