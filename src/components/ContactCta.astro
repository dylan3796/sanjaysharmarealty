---
import { site } from '../config/site';

interface Props {
  heading?: string;
  text?: string;
}
const {
  heading = 'Tell Sanjay what you need',
  text = 'Leave your name and number and he will call you back himself. No call center and no hand-offs.',
} = Astro.props;
---

<section class="section section--navy">
  <div class="wrap">
    <p class="eyebrow">Get in touch</p>
    <h2>{heading}</h2>
    <p>{text}</p>
    <div class="btn-row">
      <a class="btn" href="/contact/">Contact Sanjay</a>
      {
        site.bookingUrl && (
          <a class="btn btn--ghost" href={site.bookingUrl} rel="noopener">
            Book a call
          </a>
        )
      }
    </div>
  </div>
</section>
