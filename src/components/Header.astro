---
import { site, contactHref } from '../config/site';
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${site.brokerName}, home`}>
      <span class="brand-name">{site.brokerName}</span>
      <span class="brand-sub">{site.brokerTitle} · DRE #{site.dreNumber}</span>
    </a>

    <nav class="nav" aria-label="Main">
      {
        site.idx.searchUrl && (
          <a class="link" href={site.idx.searchUrl} target="_blank" rel="noopener">
            Search homes<span class="visually-hidden"> on {site.idx.mlsName} (opens in a new tab)</span>
          </a>
        )
      }
      <a class="call" href={contactHref}>Contact</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 5;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.8rem;
  }

  /* The name and license line take the space left over and wrap if they must, so the
     two buttons always stay on the same line. */
  .brand {
    display: grid;
    flex: 1 1 auto;
    min-width: 0;
    text-decoration: none;
    line-height: 1.2;
  }

  .brand-name {
    font: 600 1.35rem/1.1 var(--serif);
    letter-spacing: -0.01em;
  }

  /* The license number is never smaller than the smallest text on the page. */
  .brand-sub {
    font-size: 0.8125rem;
    color: var(--ink-soft);
    letter-spacing: 0.02em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex: none;
  }

  .link {
    padding: 0.4rem 0;
    font-weight: 600;
    font-size: 0.975rem;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }

  .link:hover {
    border-bottom-color: var(--brass-bright);
  }

  .call {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.55rem 1rem;
    border: 1.5px solid var(--navy);
    border-radius: var(--radius);
    background: var(--navy);
    color: var(--on-navy);
    font-weight: 600;
    font-size: 0.975rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .call:hover {
    background: var(--navy-soft);
    border-color: var(--navy-soft);
  }

  /* On a phone the page itself starts with a "Search homes" button, so the header keeps
     only Contact and the name stays on one line. */
  @media (max-width: 29.99rem) {
    .link {
      display: none;
    }
  }

  @media (min-width: 40rem) {
    .nav {
      gap: 1.5rem;
    }
  }
</style>
