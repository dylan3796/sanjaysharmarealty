---
import { site, nav } from '../config/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${site.brokerName}, home`}>
      <span class="brand-name">{site.brokerName}</span>
      <span class="brand-sub">{site.brokerTitle} · DRE #{site.dreNumber}</span>
    </a>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="visually-hidden">Menu</span>
      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="call" href={site.phone.href}>
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linejoin="round"></path>
        </svg>
        {site.phone.display}
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const navEl = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = navEl?.classList.toggle('is-open') ?? false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>

<style>
  .site-header {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 5;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 0.8rem;
  }

  .brand {
    display: grid;
    text-decoration: none;
    line-height: 1.2;
  }

  .brand-name {
    font: 600 1.35rem/1.1 var(--serif);
    letter-spacing: -0.01em;
  }

  /* The license number is never smaller than the smallest text on the page. */
  .brand-sub {
    font-size: 0.8125rem;
    color: var(--ink-soft);
    letter-spacing: 0.02em;
  }

  .menu-btn {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: none;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--ink);
    cursor: pointer;
  }

  .nav {
    display: none;
    flex-basis: 100%;
    flex-direction: column;
    gap: 0.5rem;
    padding-bottom: 0.5rem;
  }

  .nav.is-open {
    display: flex;
  }

  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .nav ul a {
    display: block;
    padding: 0.7rem 0;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    border-bottom: 1px solid var(--line);
  }

  .nav ul a[aria-current='page'] {
    color: var(--brass);
  }

  .call {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.7rem 0;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    white-space: nowrap;
  }

  @media (min-width: 72rem) {
    .menu-btn {
      display: none;
    }

    .nav {
      display: flex;
      flex-basis: auto;
      flex-direction: row;
      align-items: center;
      gap: 1.15rem;
      padding: 0;
    }

    .nav ul {
      display: flex;
      gap: 1.15rem;
    }

    .nav ul a {
      font-size: 0.925rem;
      white-space: nowrap;
    }

    .nav ul a {
      padding: 0.4rem 0;
      border-bottom: 2px solid transparent;
    }

    .nav ul a:hover,
    .nav ul a[aria-current='page'] {
      color: var(--ink);
      border-bottom-color: var(--brass-bright);
    }

    .call {
      padding: 0.55rem 0.95rem;
      border: 1.5px solid var(--navy);
      border-radius: var(--radius);
    }

    .call:hover {
      background: var(--navy);
      color: var(--on-navy);
    }
  }
</style>
