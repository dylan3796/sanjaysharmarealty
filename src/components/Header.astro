---
import { site } from '../config/site';

// Drop the preview sub-folder, if any, so the current page is still recognised.
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const on = (href: string) => (path.startsWith(href) ? 'page' : undefined);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${site.brokerName}, home`}>
      <span class="brand-name">{site.brokerName}</span>
      <span class="brand-sub">{site.brokerTitle} · DRE #{site.dreNumber}</span>
    </a>

    <nav class="nav" aria-label="Main">
      <a class="link" href="/properties/" aria-current={on('/properties/')}>Listings</a>
      <a class="call" href="/contact/" aria-current={on('/contact/')}
        >Contact<span class="wide">&nbsp;Sanjay</span></a
      >
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 5;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.8rem;
  }

  /* The name and license line take the space left over and wrap if they must, so the
     two buttons always stay on the same line. */
  .brand {
    display: grid;
    flex: 1 1 auto;
    min-width: 0;
    text-decoration: none;
    line-height: 1.2;
  }

  .brand-name {
    font: 600 1.35rem/1.1 var(--serif);
    letter-spacing: -0.01em;
  }

  /* The license number is never smaller than the smallest text on the page. */
  .brand-sub {
    font-size: 0.8125rem;
    color: var(--ink-soft);
    letter-spacing: 0.02em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex: none;
  }

  .link {
    padding: 0.4rem 0;
    font-weight: 600;
    font-size: 0.975rem;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }

  .link:hover,
  .link[aria-current='page'] {
    border-bottom-color: var(--brass-bright);
  }

  .call {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.55rem 0.9rem;
    border: 1.5px solid var(--navy);
    border-radius: var(--radius);
    background: var(--navy);
    color: var(--on-navy);
    font-weight: 600;
    font-size: 0.975rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .call:hover {
    background: var(--navy-soft);
    border-color: var(--navy-soft);
  }

  .wide {
    display: none;
  }

  /* Small phones: a slightly smaller name keeps everything on one line. */
  @media (max-width: 25rem) {
    .brand-name {
      font-size: 1.2rem;
    }
  }

  @media (min-width: 40rem) {
    .wide {
      display: inline;
    }
    .nav {
      gap: 1.5rem;
    }
    .call {
      padding-inline: 1.1rem;
    }
  }
</style>
